cabal-version: 3.0
name: lossy-chan
version: 0.1.0.0
synopsis: An implementation of a bounded lossy channel
description: An implementation of a bounded lossy channel.
license: BSD-3-Clause
license-file: LICENSE
author: Wen Kokke
maintainer: wen@well-typed.com
copyright: (c) 2026 Well-Typed
category: Concurrency
build-type: Simple
extra-doc-files: CHANGELOG.md

common language
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wprepositive-qualified-module
    -Wredundant-constraints
    -Wunticked-promoted-constructors
    -Wunused-packages

  default-extensions:
    BangPatterns
    ImportQualifiedPost
    RecordWildCards

  default-language: Haskell2010

library
  import: language
  hs-source-dirs: src
  exposed-modules: Control.Concurrent.LossyChan
  build-depends:
    base >=4.16 && <5,
    primitive,
    stm >=2 && <2.6,

test-suite lossy-chan-test
  import: language
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.16 && <5,
    lossy-chan,
    tasty,
    tasty-hunit,

benchmark lossy-chan-benchmark
  import: language
  type: exitcode-stdio-1.0
  hs-source-dirs: benchmark
  main-is: Main.hs
  build-depends:
    base >=4.16 && <5,
    criterion,
    lossy-chan,
